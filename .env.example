# Supabase project settings. Use `supabase status -o env` for local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Canonical HTTPS application origin in production (used for canonical URLs,
# robots.txt, and sitemap.xml). Keep localhost for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local or legacy projects may expose this key name instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Local projects expose the equivalent key under this name.
# SUPABASE_SERVICE_ROLE_KEY=

# OAuth sign-in providers (GitHub, Google). Read by `supabase start` via the
# env() references in supabase/config.toml; the hosted project sets the same
# credentials in its Auth dashboard instead. Each provider's callback URL must
# be <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback.
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Destination sync adapters (Obsidian/GitHub, Notion). Server-only.
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# destination secrets (GitHub PATs, Notion OAuth tokens) at rest; never stored in Postgres.
DESTINATION_TOKEN_ENCRYPTION_KEY=
# Any long random string. Signs the Notion OAuth `state` parameter (CSRF protection).
DESTINATION_OAUTH_STATE_SECRET=
# Required to connect a Notion destination (from your Notion integration's OAuth settings).
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the Notion integration.
# Notion's OAuth redirect URI validation accepts `localhost` for local dev but
# rejects `127.0.0.1` outright, so use `localhost` here even if other local
# services (e.g. Supabase auth cookies) use 127.0.0.1.
NOTION_OAUTH_REDIRECT_URI=http://localhost:3000/api/archive/destinations/notion/oauth/callback
# Arms the test-only /api/test/session sign-in route used by the authenticated
# Playwright journeys (e2e/auth.spec.ts). Set it only for local `npm run
# test:e2e` runs and the CI e2e job — never on a deployed environment. The route
# also refuses when VERCEL_ENV=production.
# E2E_TEST_LOGIN=1

# Must be named exactly CRON_SECRET: Vercel only auto-attaches the
# `Authorization: Bearer $CRON_SECRET` header to Cron Job requests for a
# variable with this exact name. Protects /api/archive/destinations/worker.
# CRON_SECRET=
