# Supabase project settings. Use `supabase status -o env` for local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local or legacy projects may expose this key name instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Local projects expose the equivalent key under this name.
# SUPABASE_SERVICE_ROLE_KEY=

# Destination sync adapters (Obsidian/GitHub, Notion). Server-only.
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# destination secrets (GitHub PATs, Notion OAuth tokens) at rest; never stored in Postgres.
DESTINATION_TOKEN_ENCRYPTION_KEY=
# Any long random string. Signs the Notion OAuth `state` parameter (CSRF protection).
DESTINATION_OAUTH_STATE_SECRET=
# Added with the Notion OAuth adapter and delivery worker (bareaga_web-2u2.2/.3):
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=
# DESTINATION_WORKER_CRON_SECRET=
